# Copie para .env e preencha (ou exporte as variáveis no shell).
OPENROUTER_API_KEY=sk-or-...

# Modelo DeepSeek no OpenRouter. Confira o slug com: python scripts/check_openrouter.py
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash

# Opcional: fixa "agora" (ISO 8601, fuso de Campo Grande). Útil para demos/testes:
# os dados de exemplo terminam em março/2026 e os prazos de devolução dependem da data.
# EMPORIO_NOW=2026-02-20T10:00:00
